{
  "name": "xml-language-client",
  "displayName": "XML Language Support",
  "description": "XML language support powered by xml-language-server",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:xml"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "xml",
        "extensions": [
          ".xml",
          ".xsd",
          ".xsl"
        ],
        "aliases": [
          "XML",
          "xml"
        ]
      }
    ],
    "configuration": {
      "title": "XML Language Server",
      "properties": {
        "xmlLanguageServer.schemas": {
          "type": "array",
          "default": [],
          "description": "Custom XSD schema associations.",
          "items": {
            "type": "object",
            "required": ["pattern", "xsdPath"],
            "properties": {
              "pattern": {
                "type": "string",
                "description": "File name or glob pattern to match (e.g. 'config.xml', '**/*.xml')."
              },
              "xsdPath": {
                "type": "string",
                "description": "Absolute path to the XSD file, or a path relative to the workspace root."
              }
            }
          }
        }
      }
    }
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "package": "vsce package"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.0.0",
    "typescript": "^6.0.3"
  }
}
