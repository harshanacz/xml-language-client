{
  "name": "xml-language-client",
  "displayName": "XML Language Support",
  "description": "Rich XML editing for VS Code, powered by a Language Server Protocol backend. Works with .xml, .xsd and .xsl files.",
  "version": "0.1.0",
  "publisher": "harshanacz",
  "license": "MIT",
  "preview": true,
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#141c36",
    "theme": "dark"
  },
  "homepage": "https://github.com/harshanacz/xml-language-client#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/harshanacz/xml-language-client.git"
  },
  "bugs": {
    "url": "https://github.com/harshanacz/xml-language-client/issues"
  },
  "keywords": [
    "xml",
    "xsd",
    "xsl",
    "xslt",
    "schema",
    "language server",
    "lsp",
    "wso2",
    "micro integrator"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:xml"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "xml",
        "extensions": [
          ".xml",
          ".xsd",
          ".xsl"
        ],
        "aliases": [
          "XML",
          "xml"
        ]
      }
    ]
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "package": "vsce package --no-dependencies --allow-missing-repository",
    "bundle": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --sourcemap --outfile=dist/extension.js"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.0.0",
    "typescript": "^6.0.3",
    "esbuild": "^0.28.0"
  }
}
