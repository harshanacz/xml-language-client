{
  "name": "xml-language-client",
  "displayName": "Schema-Aware XML",
  "description": "Schema-aware XML validation and completion for .xml, .xsd and .xsl files. JVM-free.",
  "version": "0.1.0",
  "publisher": "harshanacz",
  "license": "MIT",
  "preview": true,
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#141c36",
    "theme": "dark"
  },
  "homepage": "https://github.com/harshanacz/xml-language-client#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/harshanacz/xml-language-client.git"
  },
  "bugs": {
    "url": "https://github.com/harshanacz/xml-language-client/issues"
  },
  "keywords": [
    "xml",
    "xsd",
    "xsl",
    "xslt",
    "schema",
    "xml schema",
    "validation",
    "validator",
    "completion",
    "intellisense",
    "lint",
    "formatter",
    "language server",
    "lsp",
    "maven",
    "pom",
    "spring",
    "jvm-free",
    "no java",
    "wso2",
    "micro integrator"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "activationEvents": [
    "onLanguage:xml"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "xml",
        "extensions": [
          ".xml",
          ".xsd",
          ".xsl"
        ],
        "aliases": [
          "XML",
          "xml"
        ]
      }
    ],
    "configuration": {
      "title": "Schema-Aware XML",
      "properties": {
        "xmlLanguageServer.schemas": {
          "type": "array",
          "default": [],
          "markdownDescription": "Associate XML files with an XSD. Each entry maps a glob `pattern` to an `xsdPath`, which is absolute or relative to a workspace folder. For example `{ \"pattern\": \"**/*.config.xml\", \"xsdPath\": \"schemas/config.xsd\" }`. These associations take priority over the built-in schemas.",
          "items": {
            "type": "object",
            "required": [
              "pattern",
              "xsdPath"
            ],
            "additionalProperties": false,
            "properties": {
              "pattern": {
                "type": "string",
                "description": "Glob matched against the XML file, for example **/*.config.xml.",
                "examples": [
                  "**/*.config.xml"
                ]
              },
              "xsdPath": {
                "type": "string",
                "description": "Path to the XSD, absolute or relative to a workspace folder.",
                "examples": [
                  "schemas/config.xsd"
                ]
              }
            }
          }
        }
      }
    }
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "package": "vsce package --no-dependencies --allow-missing-repository",
    "bundle": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --sourcemap --outfile=dist/extension.js"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.0.0",
    "typescript": "^6.0.3",
    "esbuild": "^0.28.0"
  }
}
